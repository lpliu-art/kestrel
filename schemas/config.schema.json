{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "jev": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "typesafe",
            "http",
            "mock",
            "replay"
          ]
        },
        "model": {
          "type": "string"
        },
        "baseURL": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rateLimit": {
          "type": "object",
          "properties": {
            "requestsPerMinute": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "tokensPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "strategy": {
          "type": "string",
          "enum": [
            "two-pass",
            "single-pass"
          ]
        },
        "price": {
          "type": "object",
          "properties": {
            "inputPerMTok": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "properties": {
            "maxInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "dir": {
              "type": "string"
            },
            "ttlDays": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "chill",
        "balanced",
        "assertive"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "terminal",
              "json",
              "sarif",
              "markdown"
            ]
          }
        },
        "showUncertain": {
          "type": "string",
          "enum": [
            "hidden",
            "collapsed",
            "expanded"
          ]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewTests": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxAddedLinesPerFile": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxAddedLinesPerUnit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 254
        },
        "maxRulesPerUnit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rulePacks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "thresholds": {
                "type": "object",
                "properties": {
                  "report": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "uncertain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              },
              "severity": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "max": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "default": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ask": {
            "type": "string"
          },
          "expect": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "examples": {
            "type": "object",
            "properties": {
              "positive": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              },
              "negative": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "ask"
        ],
        "additionalProperties": false
      }
    },
    "static": {
      "type": "object",
      "properties": {
        "sarif": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ]
        },
        "filterMode": {
          "type": "string",
          "enum": [
            "added",
            "diff_context"
          ]
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "failOn": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "minProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "baseURL": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "apiKeyEnv": {
          "type": "string"
        },
        "maxFindings": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "verifyWithJev": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "redactSecrets": {
          "type": "boolean"
        },
        "maxEnclosingLines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sendImports": {
          "type": "string",
          "enum": [
            "auto",
            "never"
          ]
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "type": "string"
              },
              "languageId": {
                "type": "string"
              }
            },
            "required": [
              "glob",
              "languageId"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
