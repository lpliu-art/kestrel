{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ESLint",
          "rules": [
            {
              "id": "no-eval",
              "helpUri": "https://eslint.org/docs/latest/rules/no-eval"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "no-eval",
